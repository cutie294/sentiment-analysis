# ==========================================
# [OpenAI API 설정]
# ==========================================
# 1. OpenAI 플랫폼(https://platform.openai.com/api-keys)에서 발급받은 API 키를 입력하세요.
# 예: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=

# 2. 사용할 OpenAI 모델명을 입력하세요. (기본 권장: gpt-4o-mini)
# 예: gpt-4o-mini, gpt-4o
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# [Supabase 데이터베이스 설정]
# ==========================================
# 1. Supabase 대시보드(https://supabase.com/dashboard) -> 프로젝트 선택
#    -> Project Settings -> API 메뉴에서 아래 두 값을 확인할 수 있습니다.
#
# Project URL (프로젝트 고유 URL):
# 예: https://your-project-id.supabase.co
SUPABASE_URL=

# Project API Keys -> "service_role" (Secret 키):
# ※ 주의: service_role 키는 RLS(행 보안 정책)를 우회하여 서버에서만 데이터를 직접 저장할 수 있는 강력한 비밀 키입니다.
# 절대 웹 브라우저(클라이언트 코드)나 외부에 노출해서는 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=

